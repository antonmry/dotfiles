layout {
    // Tab bar above two side-by-side stacks of named shells
    // Pane names are labels; Lima and other commands are started manually
    pane split_direction="horizontal" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane {
            pane split_direction="vertical" {
                pane stacked=true {
                    pane name="host"
                    pane name="lima"
                }
                pane stacked=true {
                    pane name="host ca"
                    pane name="lima ca"
                }
            }
        }
    }
}
